class Backup {
    func create() {
        return new BackupBuilder("create", "")
    }

    func restore($backup_id) {
        return new BackupBuilder("restore", $backup_id)
    }

    func schedule() {
        return new BackupBuilder("schedule", "")
    }

    func list($provider) {
        $p = (empty($provider) == false) ? $provider : "local"
        return {"ok": true, "provider": $p, "backups": []}
    }

    func delete($backup_id, $provider) {
        $p = (empty($provider) == false) ? $provider : "local"
        return {"ok": true, "deleted": true, "backup_id": $backup_id, "provider": $p}
    }

    func verify($backup_id, $provider, $password) {
        $p = (empty($provider) == false) ? $provider : "local"
        return {"ok": true, "valid": true, "backup_id": $backup_id, "provider": $p}
    }

    func testProvider($provider) {
        return {"ok": true, "provider": $provider, "connected": true}
    }

    func migrate($target, $token) {
        return {"ok": true, "migrated": true, "target": $target}
    }
}

class BackupBuilder {
    Init constructor($mode, $backup_id) {
        $this->mode = $mode
        $this->backup_id = $backup_id
        $this->type_value = "full"
        $this->provider_value = env("STORAGE_DRIVER", "local")
        $this->encrypt_value = false
        $this->password_value = ""
        $this->at_value = "02:00"
        $this->keep_value = 7
    }

    func full() {
        $this->type_value = "full"
        return $this
    }

    func files() {
        $this->type_value = "files"
        return $this
    }

    func database() {
        $this->type_value = "database"
        return $this
    }

    func provider($provider) {
        $this->provider_value = $provider
        return $this
    }

    func encrypt($password) {
        $this->encrypt_value = true
        $this->password_value = $password
        return $this
    }

    func at($time) {
        $this->at_value = $time
        return $this
    }

    func keep($count) {
        $this->keep_value = $count
        return $this
    }

    func run() {
        return {
            "ok": true,
            "mode": $this->mode,
            "type": $this->type_value,
            "provider": $this->provider_value,
            "backup_id": $this->backup_id
        }
    }
}
